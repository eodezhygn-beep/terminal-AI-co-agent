# =========================
# API KEYS
# =========================

OPENROUTER_API_KEY=
GEMINI_API_KEY=


# =========================
# PROVIDER DEFAULTS
# =========================

DEFAULT_PROVIDER=openrouter

# Default general-purpose model
DEFAULT_MODEL=qwen/qwen3-next-80b-a3b-instruct:free


# =========================
# PROVIDER URLS
# =========================

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models


# =========================
# TASK ROUTING MODELS
# =========================

# Architecture, planning,
# UX research, product specs
PLANNING_MODEL=qwen/qwen3-next-80b-a3b-instruct:free


# Backend, APIs,
# orchestration, coding
CODING_MODEL=qwen/qwen3-next-80b-a3b-instruct:free


# Debugging, fixes,
# frontend refinement
DEBUG_MODEL=deepseek/deepseek-v4-flash:free


# Fast fallback model
FALLBACK_MODEL=gemini-2.5-flash


# =========================
# MODEL OVERRIDES
# =========================

OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
GEMINI_MODEL=gemini-2.5-flash


# =========================
# EMBEDDINGS
# =========================

OPENROUTER_EMBED_MODEL=text-embedding-3-small
